# The Odds API (https://the-odds-api.com) -- FanDuel lines and player props
ODDS_API_KEY=your_odds_api_key_here
ODDS_API_BASE_URL=https://api.the-odds-api.com

# Anthropic API -- qualitative reasoning layer
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-opus-5

# AccuWeather (https://developer.accuweather.com) -- stadium conditions.
# The variable name is historical: it is read as OPENWEATHER_API_KEY so the
# deployed secret did not have to be re-added, but the value is an AccuWeather
# key. The free tier allows 50 calls a day.
OPENWEATHER_API_KEY=your_accuweather_key_here

# Notifications (set either Discord or Telegram)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Storage
DB_PATH=data/sports_data.db

# Web app. Required before the UI may bind to anything but localhost.
# Generate one with: python -c "from src.web.auth import generate_token; print(generate_token())"
WEB_ACCESS_TOKEN=
WEB_SESSION_HOURS=336
MIN_REFRESH_SECONDS=300

# Risk / safety knobs (defaults shown; override only if you know why)
MIN_QUOTA_REMAINING=50
MIN_LEG_EV=0.04
MIN_SGP_CORRELATION=0.25
KELLY_FRACTION=0.25
MAX_CONTEXT_ADJUSTMENT=0.20
BANKROLL=1000.0
