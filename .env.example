# The Odds API (https://the-odds-api.com) -- FanDuel lines and player props
ODDS_API_KEY=your_odds_api_key_here
ODDS_API_BASE_URL=https://api.the-odds-api.com

# Anthropic API -- qualitative reasoning layer
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-opus-5

# OpenWeather (https://openweathermap.org/api) -- stadium conditions
OPENWEATHER_API_KEY=your_openweather_key_here

# Notifications (set either Discord or Telegram)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Storage
DB_PATH=data/sports_data.db

# Risk / safety knobs (defaults shown; override only if you know why)
MIN_QUOTA_REMAINING=50
MIN_LEG_EV=0.04
MIN_SGP_CORRELATION=0.25
KELLY_FRACTION=0.25
MAX_CONTEXT_ADJUSTMENT=0.20
BANKROLL=1000.0
